{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/enhancements/:route*", "destination": "/api/enhancements" },
    { "source": "/api/hr/:route*", "destination": "/api/hr" },
    { "source": "/api/ops/:route*", "destination": "/api/ops" },
    { "source": "/api/security/:route*", "destination": "/api/security" },
    { "source": "/api/documents-v2/:route*", "destination": "/api/documents-v2" },
    { "source": "/api/mail/:route*", "destination": "/api/mail" },
    { "source": "/api/resignation-admin/:route*", "destination": "/api/resignation-admin" },
    { "source": "/api/:route*", "destination": "/api/handler" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
